{
  "name": "genai-playwright",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "install:playwright": "npx playwright install",
    "bdd": "cucumber-js --require-module ts-node/register --require features/step_definitions/**/*.ts features/**/*.feature",
    "bdd:run": "cucumber-js --require-module ts-node/register --require features/step_definitions/**/*.ts features/**/*.feature"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^9.2.0",
    "@playwright/test": "^1.45.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
